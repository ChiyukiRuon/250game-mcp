{
    "name": "250game-mcp",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Standalone MCP client for 250game-server",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "npm run build && node --watch dist/index.js",
        "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
        "format:check": "prettier --check src test *.json"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.25.0",
        "ws": "^8.18.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/ws": "^8.5.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.0"
    }
}
